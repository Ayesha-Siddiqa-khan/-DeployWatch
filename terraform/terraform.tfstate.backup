            "arn": "arn:aws:iam::257536659737:policy/DeployWatch-dev-github-actions-ecr-push",
            "attachment_count": 1,
            "description": "Least-privilege ECR image push permissions for the GitHub Actions OIDC role.",
            "id": "arn:aws:iam::257536659737:policy/DeployWatch-dev-github-actions-ecr-push",
            "name": "DeployWatch-dev-github-actions-ecr-push",
            "name_prefix": "",
            "path": "/",
            "policy": "{\"Statement\":[{\"Action\":[\"ecr:GetAuthorizationToken\"],\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AllowEcrAuthorization\"},{\"Action\":[\"ecr:BatchCheckLayerAvailability\",\"ecr:CompleteLayerUpload\",\"ecr:InitiateLayerUpload\",\"ecr:PutImage\",\"ecr:UploadLayerPart\",\"ecr:BatchGetImage\",\"ecr:GetDownloadUrlForLayer\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:ecr:us-east-1:257536659737:repository/deploywatch\",\"Sid\":\"AllowPushToSelectedRepository\"}],\"Version\":\"2012-10-17\"}",
            "policy_id": "ANPATX5TBSEM5A2HAC47J",
            "tags": {},
            "tags_all": {
